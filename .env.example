# Copy this file to .env and fill in real values. .env is gitignored.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# DB_ENGINE=sqlite uses a local db.sqlite3 file (good for local dev).
# DB_ENGINE=mysql connects to MySQL via PyMySQL (used on GoDaddy hosting).
DB_ENGINE=sqlite
DB_NAME=digitanddata
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
